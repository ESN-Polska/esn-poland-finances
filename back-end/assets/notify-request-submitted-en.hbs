<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{appTitle}}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
      body {
        margin: 0;
        padding: 32px 16px;
        background-color: #f4f5f8;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #1e293b;
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }
      table { border-collapse: collapse; }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -2px rgba(0, 43, 73, 0.08);
      }
      .brand-header {
        background-color: #f8fafc;
        padding: 22px 28px;
      }
      .brand-table {
        width: 100%;
        border-collapse: collapse;
      }
      .brand-logo-cell {
        width: 44px;
        padding-right: 14px;
        vertical-align: middle;
      }
      .brand-logo {
        height: 38px;
        max-height: 38px;
        width: auto;
        max-width: 120px;
        object-fit: contain;
        display: block;
        border: 0;
      }
      .brand-text-cell {
        vertical-align: middle;
        text-align: left;
      }
      .brand-title {
        color: #0f172a !important;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .brand-org {
        color: #475569 !important;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.3;
        margin-top: 2px;
      }
      .accent-stripe {
        height: 3px;
        background: #00aeef;
        font-size: 0;
        line-height: 0;
      }
      .content {
        padding: 32px 28px 28px 28px;
      }
      .status-pill {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 20px;
        background-color: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
      }
      .page-title {
        margin: 12px 0 6px 0;
        font-size: 21px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
        letter-spacing: -0.02em;
      }
      .greeting {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        margin: 18px 0 8px 0;
      }
      .lead-text {
        font-size: 14px;
        color: #475569;
        line-height: 1.6;
        margin: 0 0 20px 0;
      }
      .details-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 6px 18px;
        margin: 20px 0;
      }
      .details-table {
        width: 100%;
        border-collapse: collapse;
      }
      .details-table td {
        padding: 10px 0;
        border-bottom: 1px solid #edf2f7;
        font-size: 13.5px;
      }
      .details-table tr:last-child td {
        border-bottom: none;
      }
      .details-label {
        color: #64748b;
        font-weight: 500;
        width: 42%;
      }
      .details-value {
        color: #0f172a;
        font-weight: 600;
        text-align: right;
      }
      .id-badge {
        display: inline-block;
        padding: 2px 8px;
        font-size: 12px;
        font-weight: 700;
        border-radius: 6px;
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
      }
      .callout-box {
        border-radius: 10px;
        padding: 14px 18px;
        margin: 20px 0;
        font-size: 13.5px;
        line-height: 1.5;
        background-color: #f0f9ff;
        border: 1px solid #bae6fd;
        border-left: 4px solid #00aeef;
        color: #0369a1;
      }
      .btn-container {
        text-align: center;
        margin: 28px 0 20px 0;
      }
      .btn {
        display: inline-block;
        background-color: #00aeef;
        color: #ffffff !important;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        padding: 13px 32px;
        border-radius: 8px;
        box-shadow: 0 4px 14px rgba(0, 174, 239, 0.35);
        letter-spacing: 0.01em;
      }
      .subtext {
        font-size: 12.5px;
        color: #64748b;
        line-height: 1.5;
        margin-top: 20px;
        text-align: center;
      }
      .footer {
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 22px 28px;
        text-align: center;
      }
      .footer-org {
        margin: 0 0 4px 0;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
      }
      .footer-app {
        margin: 0 0 10px 0;
        font-size: 12px;
        color: #64748b;
      }
      .footer-link {
        color: #00aeef;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
      }
      .footer-note {
        margin: 12px 0 0 0;
        font-size: 11px;
        color: #94a3b8;
        line-height: 1.4;
      }
      @media only screen and (max-width: 620px) {
        body { padding: 12px 8px !important; }
        .content { padding: 24px 18px !important; }
        .brand-header { padding: 18px 20px !important; }
        .footer { padding: 20px 18px !important; }
        .page-title { font-size: 19px !important; }
        .brand-title { font-size: 15px !important; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="brand-header" style="background-color: #f8fafc;">
        <table class="brand-table" cellpadding="0" cellspacing="0" border="0">
          <tr>
            {{#if appLogo}}
            <td class="brand-logo-cell">
              <img src="{{appLogo}}" alt="{{appTitle}}" class="brand-logo" />
            </td>
            {{/if}}
            <td class="brand-text-cell" style="vertical-align: middle; text-align: left;">
              <div class="brand-title" style="color: #0f172a !important; font-size: 17px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em;">{{appTitle}}</div>
              <div class="brand-org" style="color: #475569 !important; font-size: 12px; font-weight: 500; line-height: 1.3; margin-top: 2px;">{{appOrganisation}}</div>
            </td>
          </tr>
        </table>
      </div>
      <div class="accent-stripe"></div>

      <div class="content">
        <span class="status-pill">Submitted</span>
        <h1 class="page-title">Financial Request Submitted</h1>

        <div class="greeting">Hello {{user}},</div>
        <p class="lead-text">Your financial request has been successfully submitted and queued for verification.</p>

        {{#if message}}
        <div class="callout-box">
          <div class="callout-title">Note:</div>
          {{message}}
        </div>
        {{/if}}

        <div class="details-card">
          <table class="details-table" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td class="details-label">Request ID:</td>
              <td class="details-value"><span class="id-badge">{{requestId}}</span></td>
            </tr>
            <tr>
              <td class="details-label">Request Type:</td>
              <td class="details-value">{{title}}</td>
            </tr>
            <tr>
              <td class="details-label">Total Amount:</td>
              <td class="details-value">{{detail}}</td>
            </tr>
          </table>
        </div>

        <div class="btn-container">
          <a href="{{url}}" class="btn" target="_blank">View Request</a>
        </div>

        <p class="subtext">You will receive an email update once your request status changes.</p>
      </div>

      <div class="footer">
        <p class="footer-org">{{appOrganisation}}</p>
        <p class="footer-app">{{appTitle}}</p>
        <a href="{{portalUrl}}" class="footer-link" target="_blank">Open Portal &rarr;</a>
        <p class="footer-note">Automated notification &bull; Please do not reply directly to this email.</p>
      </div>
    </div>
  </body>
</html>
