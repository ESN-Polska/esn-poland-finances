<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #1e293b; background-color: #f8fafc; margin: 0; padding: 24px; }
      .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; }
      .header { background: #047857; color: #ffffff; padding: 24px 32px; text-align: left; }
      .header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }
      .header p { margin: 4px 0 0 0; font-size: 13px; opacity: 0.9; }
      .content { padding: 32px; }
      .paid-box { background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 18px; margin: 20px 0; border-radius: 0 8px 8px 0; font-size: 14px; color: #065f46; }
      .details-table { width: 100%; margin: 16px 0; border-collapse: collapse; }
      .details-table td { padding: 8px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
      .details-table td.label { color: #64748b; width: 40%; }
      .details-table td.value { font-weight: 600; text-align: right; }
      .btn { display: inline-block; background-color: #10b981; color: #ffffff !important; font-weight: 600; text-decoration: none; padding: 12px 28px; border-radius: 8px; margin: 20px 0; text-align: center; }
      .footer { padding: 20px 32px; background: #f8fafc; border-top: 1px solid #e2e8f0; font-size: 12px; color: #64748b; text-align: center; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>ESN Poland &bull; Finances</h1>
        <p>Payment Processed</p>
      </div>
      <div class="content">
        <p>Hello <b>{{user}}</b>,</p>
        
        <div class="paid-box">
          The funds for your financial request <b>{{requestId}}</b> have been transferred to your specified bank account!
        </div>

        <table class="details-table">
          <tr>
            <td class="label">Request ID:</td>
            <td class="value">{{requestId}}</td>
          </tr>
          <tr>
            <td class="label">Request Type:</td>
            <td class="value">{{title}}</td>
          </tr>
          <tr>
            <td class="label">Paid Amount:</td>
            <td class="value">{{detail}}</td>
          </tr>
        </table>

        {{#if message}}
        <p style="font-size: 14px; color: #475569;">
          <b>Note from Treasurer:</b> {{message}}
        </p>
        {{/if}}

        <p style="text-align: center;">
          <a href="{{url}}" class="btn" target="_blank">View Request Details</a>
        </p>

        <p style="color: #64748b; font-size: 13px;">
          Interbank transfer processing may take up to 1-2 business days depending on your bank's clearing sessions.
        </p>
      </div>
      <div class="footer">
        ESN Poland Federation<br />
        Automated notification &bull; <a href="{{url}}" style="color: #00aeef;">{{url}}</a>
      </div>
    </div>
  </body>
</html>
